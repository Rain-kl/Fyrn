<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ====================================================================== -->
    <!-- 项目基本信息 -->
    <!-- ====================================================================== -->
    <groupId>net.arctel</groupId>
    <artifactId>fyrn</artifactId>
    <version>0.0.1-SNAPSHOT</version>

    <parent>
        <groupId>net.arctel.platform</groupId>
        <artifactId>Axion</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <packaging>pom</packaging>

    <name>Fyrn Backend</name>
    <description>Fyrn 后端服务 - 企业级多模块项目</description>

    <!-- ====================================================================== -->
    <!-- 子模块 -->
    <!-- ====================================================================== -->
    <modules>
        <module>fyrn-common</module>
        <module>fyrn-mms</module>
        <module>fyrn-opkit</module>
        <module>fyrn-aggregation</module>
        <module>fyrn-workbench</module>
    </modules>

    <!-- ====================================================================== -->
    <!-- 统一属性配置 -->
    <!-- ====================================================================== -->
    <properties>
        <fyrn.version>${project.version}</fyrn.version>
        <axion.version>1.0-SNAPSHOT</axion.version>
        <oms.version>1.0-SNAPSHOT</oms.version>
    </properties>

    <!-- ====================================================================== -->
    <!-- 依赖版本管理 -->
    <!-- ====================================================================== -->
    <dependencyManagement>
        <dependencies>

            <!-- ==================== 内部模块版本管理 ==================== -->
            <!-- Fyrn 核心模块 -->
            <dependency>
                <groupId>net.arctel</groupId>
                <artifactId>fyrn-common</artifactId>
                <version>${fyrn.version}</version>
            </dependency>

            <!-- Fyrn MMS 模块 -->
            <dependency>
                <groupId>net.arctel</groupId>
                <artifactId>fyrn-mms-api</artifactId>
                <version>${fyrn.version}</version>
            </dependency>
            <dependency>
                <groupId>net.arctel</groupId>
                <artifactId>fyrn-mms-domain</artifactId>
                <version>${fyrn.version}</version>
            </dependency>
            <dependency>
                <groupId>net.arctel</groupId>
                <artifactId>fyrn-mms-service</artifactId>
                <version>${fyrn.version}</version>
            </dependency>

            <dependency>
                <groupId>net.arctel</groupId>
                <artifactId>wb-api</artifactId>
                <version>${fyrn.version}</version>
            </dependency>
            <dependency>
                <groupId>net.arctel</groupId>
                <artifactId>wb-model</artifactId>
                <version>${fyrn.version}</version>
            </dependency>
            <dependency>
                <groupId>net.arctel</groupId>
                <artifactId>wb-service</artifactId>
                <version>${fyrn.version}</version>
            </dependency>

            <!--
                OMS 模块版本管理
                通过 BOM 导入 axion-oms 的依赖管理, 自动继承所有 OMS 子模块版本
            -->
            <dependency>
                <groupId>net.arctel.platform</groupId>
                <artifactId>axion-oms</artifactId>
                <version>${oms.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!--
                OPKIT 模块版本管理
            -->
            <dependency>
                <groupId>net.arctel.platform</groupId>
                <artifactId>opkit-agent</artifactId>
                <version>${fyrn.version}</version>
            </dependency>
            <dependency>
                <groupId>net.arctel.platform</groupId>
                <artifactId>opkit-api</artifactId>
                <version>${fyrn.version}</version>
            </dependency>
            <dependency>
                <groupId>net.arctel.platform</groupId>
                <artifactId>opkit-service</artifactId>
                <version>${fyrn.version}</version>
            </dependency>
            <dependency>
                <groupId>net.arctel.platform</groupId>
                <artifactId>opkit-domain</artifactId>
                <version>${fyrn.version}</version>
            </dependency>
            <dependency>
                <groupId>net.arctel.platform</groupId>
                <artifactId>opkit-common</artifactId>
                <version>${fyrn.version}</version>
            </dependency>
            <dependency>
                <groupId>net.arctel.platform</groupId>
                <artifactId>opkit-app</artifactId>
                <version>${fyrn.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>

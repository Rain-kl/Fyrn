<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ====================================================================== -->
    <!-- 父模块引用 -->
    <!-- 注意: 当 OMS 独立部署时, 需要将 parent 改为 spring-boot-starter-parent -->
    <!-- 并取消注释下方 "独立部署时的配置" 部分 -->
    <!-- ====================================================================== -->
    <parent>
        <groupId>com.arctel</groupId>
        <artifactId>fyrn</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <!-- ====================================================================== -->
    <!-- OMS 模块基本信息 -->
    <!-- 使用独立的 groupId 便于将来独立拆分 -->
    <!-- ====================================================================== -->
    <groupId>com.arctel.platform</groupId>
    <artifactId>oms</artifactId>
    <packaging>pom</packaging>

    <name>OMS - 运维管理系统</name>
    <description>运维管理系统, 包含 Redis 管理、系统参数管理、用户认证、任务管理等功能。该模块设计为可独立拆分部署。</description>

    <!-- ====================================================================== -->
    <!-- 子模块 -->
    <!-- ====================================================================== -->
    <modules>
        <module>oms-domain</module>
        <module>oms-common</module>
        <module>oms-api</module>
        <module>oms-infrastructure</module>
        <module>oms-service</module>
    </modules>

    <!-- ====================================================================== -->
    <!-- OMS 模块属性配置 -->
    <!-- 独立管理版本号，便于后续拆分 -->
    <!-- ====================================================================== -->
    <properties>
        <!-- OMS 版本号, 独立于主项目版本 -->
        <oms.version>${project.version}</oms.version>
        
        <!-- ==================== 独立部署时取消注释以下配置 ==================== -->
        <!--
        <java.version>17</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        
        <spring-boot.version>3.4.13</spring-boot.version>
        <mybatis-plus.version>3.5.9</mybatis-plus.version>
        <druid.version>1.2.1</druid.version>
        <hutool-all.version>5.8.40</hutool-all.version>
        <fastjson2.version>2.0.36</fastjson2.version>
        <commons-lang3.version>3.18.0</commons-lang3.version>
        <minio.version>8.6.0</minio.version>
        <caffeine.version>3.1.8</caffeine.version>
        <juniversalchardet.version>1.0.3</juniversalchardet.version>
        -->
    </properties>

    <!-- ====================================================================== -->
    <!-- OMS 内部模块版本管理 -->
    <!-- 便于 OMS 内部模块间相互依赖时版本统一 -->
    <!-- ====================================================================== -->
    <dependencyManagement>
        <dependencies>
            <!-- ==================== OMS 内部模块 ==================== -->
            <dependency>
                <groupId>com.arctel.platform</groupId>
                <artifactId>oms-domain</artifactId>
                <version>${oms.version}</version>
            </dependency>
            <dependency>
                <groupId>com.arctel.platform</groupId>
                <artifactId>oms-common</artifactId>
                <version>${oms.version}</version>
            </dependency>
            <dependency>
                <groupId>com.arctel.platform</groupId>
                <artifactId>oms-api</artifactId>
                <version>${oms.version}</version>
            </dependency>
            <dependency>
                <groupId>com.arctel.platform</groupId>
                <artifactId>oms-infrastructure</artifactId>
                <version>${oms.version}</version>
            </dependency>
            <dependency>
                <groupId>com.arctel.platform</groupId>
                <artifactId>oms-service</artifactId>
                <version>${oms.version}</version>
            </dependency>

            <!-- ==================== 独立部署时取消注释以下配置 ==================== -->
            <!--
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-bom</artifactId>
                <version>${mybatis-plus.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            -->
        </dependencies>
    </dependencyManagement>

    <!-- ====================================================================== -->
    <!-- 构建配置 -->
    <!-- ====================================================================== -->
    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <configuration>
                    <!-- POM 模块跳过打包 -->
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>